rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'eeT0iJOXYlU7g7l6fh9hL5kCLDL2';
    }

    match /projetos/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
